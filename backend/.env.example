PORT=4700
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/emedicine
DB_SSL=false
# For providers that require TLS, use DB_SSL=true and a trusted CA.
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_URL=http://localhost:3000
APPOINTMENT_TIME_ZONE=America/Argentina/Buenos_Aires
NODE_ENV=development
